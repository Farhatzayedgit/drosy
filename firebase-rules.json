{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "teacherUid": {
        ".read": true,
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length < 128"
      },
      ".read": true
    },
    "pub": {
      ".write": "auth != null && auth.uid === root.child('config/teacherUid').val()",
      "teacher": {
        ".read": "auth != null"
      },
      "groups": {
        ".read": "auth != null"
      },
      "notices": {
        ".read": "auth != null"
      },
      "exams": {
        ".read": "auth != null"
      },
      "students": {
        ".read": "auth != null && auth.uid === root.child('config/teacherUid').val()",
        "$code": {
          ".read": "auth != null"
        }
      },
      "mine": {
        ".read": "auth != null && auth.uid === root.child('config/teacherUid').val()",
        "$code": {
          ".read": "auth != null"
        }
      }
    },
    "private": {
      ".read": "auth != null && auth.uid === root.child('config/teacherUid').val()",
      ".write": "auth != null && auth.uid === root.child('config/teacherUid').val()"
    },
    "bookings": {
      ".read": "auth != null && auth.uid === root.child('config/teacherUid').val()",
      "$id": {
        ".write": "auth != null && (!data.exists() || auth.uid === root.child('config/teacherUid').val())",
        ".validate": "newData.hasChildren(['name','grade','phone']) && newData.child('name').isString() && newData.child('name').val().length >= 3 && newData.child('name').val().length <= 60 && newData.child('grade').isString() && newData.child('grade').val().length <= 40 && newData.child('phone').isString() && newData.child('phone').val().length >= 10 && newData.child('phone').val().length <= 15 && newData.child('addr').val().length <= 120 && newData.child('note').val().length <= 200",
        "$other": {
          ".validate": true
        }
      }
    },
    "attempts": {
      "$code": {
        "$examId": {
          "$sid": {
            ".read": "auth != null && (auth.uid === root.child('config/teacherUid').val() || auth.token.uid === auth.uid)",
            ".write": "auth != null && (auth.uid === root.child('config/teacherUid').val() || !data.child('submittedAt').exists() || data.child('submittedAt').val() == 0)",
            ".validate": "newData.hasChildren(['id','examId','sid','startedAt'])",
            "submittedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      }
    },
    "results": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === root.child('config/teacherUid').val()"
    }
  }
}